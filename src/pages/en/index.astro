---
import Layout from '../../layouts/Layout.astro';
import Home from '../../components/Home.astro';
import { I18N, SITE } from '../../data/portfolio';

const lang = 'en' as const;
const t = I18N[lang];
---
<Layout
  title={`${SITE.name} — ${t.subtitle}`}
  description={t.home.heroBody}
  lang={lang}
  langSwitchHref="/"
>
  <Home lang={lang} />
</Layout>
