# ============================================================================
#  SkyCobra Studio — Apache configuration (OVH shared hosting)
#
#  TWO SWITCHES, driven by the mere presence of a file at the root of www/.
#  Day-to-day use requires no edit to this file.
#
#    holding.flag      -> everyone sees /holding.html (200 response)
#    maintenance.flag  -> everyone sees /maintenance.html (503 response)
#
#  Enable  : upload an empty file with that name into www/
#  Disable : delete it
#
#  In both cases the IP declared below keeps seeing the real site, which allows
#  working and checking before opening the doors.
# ============================================================================

# ⚠️ TO FILL IN: your public IP address (https://ifconfig.me).
#    While it is wrong you will see the holding page like everyone else.
#    If your IP changes (router reboot), update it here.
SetEnvIf Remote_Addr "^203\.0\.113\.1$" ADMIN_IP

RewriteEngine On

# ── 1. Force HTTPS ──────────────────────────────────────────────────────────
#    OVH puts a proxy in front of Apache: test the forwarded header, not %{HTTPS}.
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── 2. One canonical address: no www ───────────────────────────────────────
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ── 3. Maintenance (503) ────────────────────────────────────────────────────
#    503 rather than 404: search engines understand it is temporary and do not
#    deindex the site.
RewriteCond %{DOCUMENT_ROOT}/maintenance.flag -f
RewriteCond %{ENV:ADMIN_IP} !=1
RewriteCond %{REQUEST_URI} !^/maintenance\.html$
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpe?g|gif|svg|webp|ico|woff2?)$
RewriteRule ^ - [R=503,L]
ErrorDocument 503 /maintenance.html

# ── 4. Holding page (200) ───────────────────────────────────────────────────
#    Unlike maintenance, this is intentional content: serve the page with no
#    redirect and no error code.
RewriteCond %{DOCUMENT_ROOT}/holding.flag -f
RewriteCond %{ENV:ADMIN_IP} !=1
RewriteCond %{REQUEST_URI} !^/holding.html$
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpe?g|gif|svg|webp|ico|woff2?)$
RewriteRule ^ /holding.html [L]

# ── 5. Security headers ─────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Stop the browser guessing a content type other than the declared one.
  Header always set X-Content-Type-Options "nosniff"

  # Do not leak the full URL to external sites.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # No sensitive API is used, so switch them all off.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

  # HSTS — cautious rollout. Once a browser has seen this header it REFUSES any
  # HTTP access for the stated duration, and that cannot be undone remotely.
  # Hence starting at 5 minutes.
  # Raise to "max-age=31536000; includeSubDomains" after ~1 week without incident.
  Header always set Strict-Transport-Security "max-age=300"

  # Content Security Policy. 'unsafe-inline' on style-src is required by Astro,
  # which injects inline styles. frame-src allows embedded itch.io games and
  # cookie-free YouTube videos.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://img.itch.zone; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-src https://itch.io https://*.itch.io https://www.youtube-nocookie.com; script-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"

  # ⚠️ WHILE THE SITE IS UNDER CONSTRUCTION: block indexing.
  #    REMOVE THIS on the day of the official launch, or the site will never
  #    appear in search results.
  Header always set X-Robots-Tag "noindex, nofollow"

  # Tell crawlers to come back later during maintenance.
  Header always set Retry-After "7200" "expr=%{REQUEST_STATUS} == 503"
</IfModule>

# ── 6. Cache ────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # Astro's files carry a hash in their name, so cache them for a long time.
  <FilesMatch "\.(css|js|woff2?|svg|png|jpe?g|webp|ico)$">
    ExpiresDefault "access plus 1 year"
    Header append Cache-Control "immutable"
  </FilesMatch>
  # HTML must stay fresh so updates are visible.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── 7. Misc ─────────────────────────────────────────────────────────────────
# No directory listing.
Options -Indexes

# Do not serve working files if they ever land here by mistake.
<FilesMatch "^(\.env|\.git.*|.*\.md|package.*\.json)$">
  Require all denied
</FilesMatch>
