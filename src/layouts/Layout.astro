---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Lantern from '../components/Lantern.astro';
import { SITE, type Lang } from '../data/portfolio';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  /** Path of the same page in the other language. */
  langSwitchHref: string;
  /** NAV href of the current page, so the nav can mark it. */
  current?: string;
}

const {
  title,
  description = 'SkyCobra Studio — développement XR, VR et jeu vidéo.',
  lang = 'fr',
  langSwitchHref,
  current,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site ?? `https://${SITE.domain}`).toString();
const ogImage = new URL(`${base}og.jpg`, Astro.site ?? `https://${SITE.domain}`).toString();
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_US';
const ogLocaleAlt = lang === 'fr' ? 'en_US' : 'fr_FR';
const skipLabel = lang === 'fr' ? 'Aller au contenu' : 'Skip to content';
---
<!doctype html>
<html lang={lang} data-theme="night">
  <head>
    <meta charset="UTF-8" />
    {/* The theme must be applied BEFORE first paint, otherwise night would show
        for a fraction of a second before day settles in. Hence this inline
        script — deliberately tiny and dependency-free. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('skycobra-theme');
          /* Only two values are valid. Anything else — a stale key from an
             earlier naming, a hand-edited entry — falls back to the system
             preference rather than being applied verbatim. */
          if (stored !== 'night' && stored !== 'day') {
            stored = window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'day' : 'night';
          }
          document.documentElement.dataset.theme = stored;
        } catch (e) {
          /* localStorage unavailable (strict private browsing): keep night,
             the value already present in the HTML. */
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content={SITE.twitter} />

    <!-- The artwork covers the whole screen from the first paint, so preload
         the night one, which is the default. The day one is only fetched if the
         visitor flips the lantern — no point paying 154 KB up front. -->
    <link rel="preload" as="image" href={`${base}bg-night.webp`} type="image/webp" />
    <link rel="preload" as="image" href={`${base}lantern.webp`} type="image/webp" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=IM+Fell+English:ital@0;1&family=JetBrains+Mono:wght@400;500&family=Lora:ital,wght@0,400;0,500;1,400;1,500;1,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <Lantern lang={lang} />
    <SiteNav lang={lang} langSwitchHref={langSwitchHref} current={current} />
    <slot />
    <SiteFooter lang={lang} />

    <script is:inline>
      (function () {
        var btn = document.querySelector('[data-lantern]');
        if (!btn) return;
        var root = document.documentElement;

        function syncPressed() {
          btn.setAttribute('aria-pressed', String(root.dataset.theme === 'night'));
        }
        syncPressed();

        btn.addEventListener('click', function () {
          var next = root.dataset.theme === 'night' ? 'day' : 'night';
          root.dataset.theme = next;
          syncPressed();
          try { localStorage.setItem('skycobra-theme', next); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
